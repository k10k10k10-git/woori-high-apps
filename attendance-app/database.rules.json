{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "attendanceAdmins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
        ".validate": "newData.isBoolean()"
      }
    },
    "teacherClasses": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$uid": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === $uid || root.child('attendanceAdmins').child(auth.uid).val() === true)"
      }
    },
    "userRoles": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$emailKey": {
        ".read": "auth != null && data.child('email').val() === auth.token.email"
      },
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "classes": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$year": {
        "$classKey": {
          ".read": "auth != null && root.child('teacherClasses').child(auth.uid).val() === $classKey",
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherClasses').child(auth.uid).val() === $classKey || root.child('attendanceAdmins').child(auth.uid).val() === true)",
          "students": {
            "$studentId": {
              ".write": "auth != null && root.child('retreatAdmins').child(auth.uid).child('semesterRole').val() === 'adminTeam'"
            }
          }
        }
      }
    },
    "attendance": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$year": {
        "$classKey": {
          ".read": "auth != null && root.child('teacherClasses').child(auth.uid).val() === $classKey",
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherClasses').child(auth.uid).val() === $classKey || root.child('attendanceAdmins').child(auth.uid).val() === true)",
          "$studentId": {
            ".write": "auth != null && root.child('retreatAdmins').child(auth.uid).child('semesterRole').val() === 'adminTeam'"
          }
        }
      }
    },
    "events": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "teacherData": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "teacherStaff": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "teacherAdditional": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "config": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "teacherSpecial": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "teacherExtra": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      "$year": {
        "$part": {
          "$classKey": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherClasses').child(auth.uid).val().replace('-','_').replace('-','_').replace('-','_') === $classKey || root.child('attendanceAdmins').child(auth.uid).val() === true)"
          }
        }
      }
    },
    "teacherPhones": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)"
    },
    "trash": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$year": {
        "students": {
          "$studentId": {
            ".read": "auth != null && root.child('retreatAdmins').child(auth.uid).child('semesterRole').val() === 'adminTeam'",
            ".write": "auth != null && root.child('retreatAdmins').child(auth.uid).child('semesterRole').val() === 'adminTeam'"
          }
        }
      }
    },
    "suggestions": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('attendanceAdmins').child(auth.uid).val() === true)",
      "$year": {
        "$classKey": {
          ".read": "auth != null && root.child('teacherClasses').child(auth.uid).val() === $classKey",
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('teacherClasses').child(auth.uid).val() === $classKey || root.child('attendanceAdmins').child(auth.uid).val() === true)"
        }
      }
    },
    "retreatAdmins": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      },
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "retreatPending": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "iguardMembers": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      },
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "iguardRoles": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === 'staff' || newData.val() === 'team'"
      }
    },
    "iguardPending": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "retreats": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
      "$retreatId": {
        "milestones": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || (root.child('iguardMembers').child(auth.uid).val() != null && root.child('iguardRoles').child(auth.uid).val() !== 'staff'))",
          "$milestoneId": {
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "targetDate": {
              ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "note": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 500)"
            },
            "createdAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "newData.val() === null || newData.isNumber()"
            },
            "sourceSite": {
              ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)"
            }
          }
        },
        "partialAttendances": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
          "$studentKey": {
            ".validate": "newData.hasChildren(['type'])",
            "type": {
              ".validate": "newData.val() === '선복귀' || newData.val() === '후발대' || newData.val() === '당일참석'"
            },
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "updatedAt": {
              ".validate": "newData.isNumber()"
            },
            "day": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "iguard": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || (root.child('iguardMembers').child(auth.uid).val() != null && root.child('iguardRoles').child(auth.uid).val() !== 'staff'))",
          "attendance": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
            "$key": {
              "checked": {
                ".validate": "newData.isBoolean()"
              },
              "updatedAt": {
                ".validate": "newData.val() === null || newData.isNumber()"
              }
            }
          },
          "meals": {
            "$mealId": {
              "label": {
                ".validate": "newData.isString()"
              },
              "day": {
                ".validate": "newData.isNumber()"
              },
              "slot": {
                ".validate": "newData.isNumber()"
              },
              "entries": {
                "$idx": {
                  "groupId": {
                    ".validate": "newData.isString()"
                  },
                  "seq": {
                    ".validate": "newData.isNumber()"
                  },
                  "round": {
                    ".validate": "newData.val() === '선밥' || newData.val() === '후밥'"
                  }
                }
              }
            }
          }
        }
      }
    },
    "retreatsPrivate": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
      "$retreatId": {
        "cancellations": {
          ".indexOn": [
            "studentKey"
          ]
        }
      }
    },
    "prepMilestones": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || (root.child('iguardMembers').child(auth.uid).val() != null && root.child('iguardRoles').child(auth.uid).val() !== 'staff') || root.child('iguardMembers').child(auth.uid).child('sundayWrite').val() === true)",
      "$milestoneId": {
        "title": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "targetDate": {
          ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
        },
        "done": {
          ".validate": "newData.isBoolean()"
        },
        "note": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 500)"
        },
        "createdAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "sourceSite": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)"
        }
      }
    },
    "brainstorm": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
      "$noteId": {
        "title": {
          ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 120)"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 2000"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "x": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "y": {
          ".validate": "newData.val() === null || newData.isNumber()"
        },
        "comments": {
          "$commentId": {
            "author": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 1000"
            },
            "createdAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "semesters": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null || root.child('iguardMembers').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)"
    },
    "semestersPrivate": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('retreatAdmins').child(auth.uid).val() != null)"
    }
  }
}
