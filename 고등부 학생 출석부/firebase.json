{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "predeploy": [
      "node tools/update-cache-version.js",
      "npm run build"
    ],
    "public": "out",
    "ignore": [
      "firebase.json",
      "tools/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
